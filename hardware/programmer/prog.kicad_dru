(version 1)

# GENERATED by hardware/programmer/scripts/gen_pcb.py -- do not edit.
# JLCPCB standard 2-layer limits (2026-11): 0.127 mm track/space, 0.3 mm via
# drill.  The board's own rules (prog.kicad_pro) sit at or above them:
# 0.13 mm clearance, 0.15 mm track, 0.5/0.3 mm via, 0.3 mm copper to edge.

# USB-C receptacle: its two pad rows are fixed by the manufacturer at 0.2 mm
(rule "J1 land pattern"
	(constraint clearance (min 0.12mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))

# USB-C mouth: the receptacle overhangs the edge by design (spec 6.1), so its
# body outline is printed up to the edge and the fab clips it there
(rule "J1 silk at the mouth"
	(constraint silk_clearance (min 0mm))
	(severity ignore)
	(condition "A.memberOfFootprint('J1') && A.Layer == 'F.SilkS'"))

# a pad squeezed between fine-pitch neighbours may land on the pour with one
# spoke; the pad's own GND escape via carries it
(rule "one spoke"
	(constraint min_resolved_spokes 1))
