		(comment 2 "Board 140 x 100 mm, 8 layer, 1 oz copper on all layers, JLCPCB")
	)
	(layers
		(0 "F.Cu" signal)
		(4 "In1.Cu" power "GND_In1")
		(6 "In2.Cu" signal)
		(8 "In3.Cu" power "GND_In3")
