	(gr_text "LAYOUT CONSTRAINTS (spec 9.3, 9.4, 10 / plan Task 8), 200 x 140 mm, 8 layers" (at 23 124) (layer "Cmts.User") (uuid "f3946ad9-acf3-59f3-99e4-437917e76ec9")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Was 140 x 100 mm / 6 layers until 2026-09-23 (see board outline block, layout_pcb.py)." (at 23 126.1) (layer "Cmts.User") (uuid "0b6deb7b-5b06-5adc-81ba-22d9accdb64d")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "STACKUP (1.6 mm, 1 oz throughout, see gen_pcb.STACKUP for the full dielectric table):" (at 23 128.2) (layer "Cmts.User") (uuid "ebead352-1490-5255-9211-d0afccb63745")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "F.Cu sig / In1.Cu GND / In2.Cu sig (CAN pair) / In3.Cu GND / In4.Cu POWER (VBAT) /" (at 23 130.3) (layer "Cmts.User") (uuid "8390de89-429b-50a6-9766-0d13ce3e264d")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "In5.Cu sig / In6.Cu GND / B.Cu sig. Every signal layer has a solid GND plane on at" (at 23 132.4) (layer "Cmts.User") (uuid "402da31b-bd88-5bcb-ba1c-b5a11f1e8441")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "least one face, and In2.Cu (CAN) has one on both -- a buried stripline by construction." (at 23 134.5) (layer "Cmts.User") (uuid "be2a0d9b-9623-5f67-b6ae-37a662149a1d")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Assembly is SINGLE SIDED -- nothing on B.Cu." (at 23 136.6) (layer "Cmts.User") (uuid "1944b8a8-d571-5400-bdfa-05ec6f088d14")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "FEED path (7.0 A cont, 7.8 A transient): the In4.Cu polygon is a solid /VBAT plane," (at 23 138.7) (layer "Cmts.User") (uuid "a0b62477-d0a0-5f3a-a148-391a76fa2760")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "priority 0, nothing else on the layer -- +24V, +5V and VLOGIC_IN are routed like any" (at 23 140.8) (layer "Cmts.User") (uuid "b30f8082-e586-5e25-90c0-5e58208aa056")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "other net (see route_external.HANDS_OFF), not carved out as zones. Measured at" (at 23 142.9) (layer "Cmts.User") (uuid "788310ee-4946-5085-a091-817cb5d77c57")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "106.50 mm on its worst cut against the 11.44 mm IPC-2221 asks (10 C rise, internal," (at 23 145) (layer "Cmts.User") (uuid "1d50037a-afa2-5c7a-8589-a70ef4ace621")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "1 oz) -- see scripts/check_plane_width.py. On F.Cu the FEED class floor is" (at 23 147.1) (layer "Cmts.User") (uuid "6ec9d2e1-b58e-5493-ab3e-6e2c209d8123")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "3.5 mm = a 20 C rise; POUR to >= 4.5 mm for 10 C on any real run. No TRACK carries it." (at 23 149.2) (layer "Cmts.User") (uuid "df81f70a-ee7b-5250-afc2-fb560ad48139")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "HEAT LEAVES THROUGH THE BASE, NOT AN EDGE: the plate is the face UNDER the board and" (at 23 151.3) (layer "Cmts.User") (uuid "73d34c43-0c5d-51b3-8b24-ea04e0fe421e")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "couples through B.Cu. Thermal group L2 (0.78 W), U9 (0.35 W), L1 (0.28 W), U3, L3 --" (at 23 153.4) (layer "Cmts.User") (uuid "719ade1f-4cc7-5292-9c41-cba9d3c46a1a")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "~1.6 W of the 2.31 W night total. L2 has no paddle; its heat goes to board copper." (at 23 155.5) (layer "Cmts.User") (uuid "943cda08-c784-516f-99ea-f6b952b2d398")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "There are NO external boost FETs and NO P-FET. Night governs, not daytime." (at 23 157.6) (layer "Cmts.User") (uuid "3d9c24bc-de22-56af-9d21-3bede4fff7ad")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "eFuse island near J1, and NOT via-coupled to the plate: U10, Q10, Q11, R100, C65." (at 23 159.7) (layer "Cmts.User") (uuid "44f25b37-68ee-51a6-8ee0-8592c1f7f353")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "R100 needs its own copper and a Kelvin tap. C65 must sit AT U10 pin 5." (at 23 161.8) (layer "Cmts.User") (uuid "f20d7dc1-3083-564d-aeb0-97314305ef25")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Antenna edge is RIGHT: no copper, plating or parts on ANY layer in the U5 keep-out." (at 23 163.9) (layer "Cmts.User") (uuid "a8a6a7f2-6e83-5c56-a50c-7c9426fe734c")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Wire-exit field is BOTTOM: J1 power at the far left, J2 CAN at the far right." (at 23 166) (layer "Cmts.User") (uuid "ada2c358-062b-51d9-8449-f93121dfc696")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Boost switch-node loop area minimised. NO gate loops: U3 switches internally, so the" (at 23 168.1) (layer "Cmts.User") (uuid "e78ce6ab-067a-599d-9018-62cb26790398")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "only fast edge is SW -> D4 -> C61 -> PGND. Keep that loop tight; nothing else here is." (at 23 170.2) (layer "Cmts.User") (uuid "0152af30-7e69-5813-bef5-2db177b1d0d5")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "GND_IN and GND are SEPARATE and meet at TWO places only: L2 winding B, and R3." (at 23 172.3) (layer "Cmts.User") (uuid "9f0e6fec-da87-56a7-aaa3-adaed3e617c2")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "The plane must not bridge them anywhere else -- see scripts/check_grounds.py." (at 23 174.4) (layer "Cmts.User") (uuid "fdce9591-f402-5c60-9e49-b41e43b3d624")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "THERMAL / FAB / DFM" (at 23 165) (layer "Cmts.User") (uuid "061a2300-ac41-521f-b3d7-07e19935f713")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "VIA IN PAD: U1.9, U2.9, U3.17, U9.15 and D4.3 are filled with 0.55 / 0.25 mm vias." (at 23 166.68) (layer "Cmts.User") (uuid "139db962-c946-5e53-a7b9-4000d8171da9")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "These MUST be plugged and capped (IPC-4761 type IV or VI) -- unplugged vias in a" (at 23 168.36) (layer "Cmts.User") (uuid "d84f65e3-ff4e-5c35-9b43-d5e707e98ba2")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "solderable paddle wick paste out of the joint and void the thermal path they exist for." (at 23 170.04) (layer "Cmts.User") (uuid "f7669b44-92ad-507a-9b95-0f96365f0905")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "Heat leaves through B.Cu: assembly is single sided and the bottom is bare on purpose." (at 23 171.72) (layer "Cmts.User") (uuid "acc36c22-ed13-5708-8c44-c848630fa9a0")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "Gap pad contacts the two dashed Cmts.User patches, ~1360 mm2 total. Do not tent the" (at 23 173.4) (layer "Cmts.User") (uuid "1dce682b-5193-5491-87f0-e5939f441ebb")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "stitching vias inside them on B.Cu any more than the rest of the bottom side." (at 23 175.08) (layer "Cmts.User") (uuid "22569645-e679-5dcf-ad73-e97186bd714e")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "U10 is MSOP-10 with NO exposed pad; its dissipation leaves through the lead frame." (at 23 176.76) (layer "Cmts.User") (uuid "5ec80eac-4852-56b1-8884-a377df2dcee7")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "B.Cu under D4 is +24 V, not ground. The gap pad is the ONLY thing between it and the" (at 23 178.44) (layer "Cmts.User") (uuid "7c5fb227-a076-5c72-8d04-56ceb0c06759")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "plate -- it must be an insulator rated for the rail, not a conductive filler." (at 23 180.12) (layer "Cmts.User") (uuid "75fb61f7-802c-597e-a663-e7c52cda579c")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "" (at 23 181.8) (layer "Cmts.User") (uuid "76bd6d09-a3a0-58e8-a371-bbc2820f55ee")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "ORDER NOTES -- these are not defaults, they have to be asked for:" (at 23 183.48) (layer "Cmts.User") (uuid "c9a70897-4034-5cb8-9f5d-b46b920cf421")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "1. VIA IN PAD PLUGGED AND CAPPED on the five paddles above. The default finish is" (at 23 185.16) (layer "Cmts.User") (uuid "e2bbb124-a460-5b36-b665-6e4d1c2f96cb")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   TENTED, which is a mask skin over an open barrel and is not the same thing." (at 23 186.84) (layer "Cmts.User") (uuid "5d210953-b5da-5517-a122-939b74663901")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "2. NO SOLDER MASK DAM at U10. Its leads leave a 0.15 mm gap, and a dam that thin does" (at 23 188.52) (layer "Cmts.User") (uuid "0ee10226-dea3-5338-8d97-b9ccc9bef485")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   not survive the mask process -- a half-formed sliver is worse than none. Run the" (at 23 190.2) (layer "Cmts.User") (uuid "6b5cdf5a-f93b-563b-939c-d7c754d66f7a")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   opening across the leads and let the paste stencil define the joints." (at 23 191.88) (layer "Cmts.User") (uuid "8d394172-91fa-5cdb-a31d-6fd4067a4e39")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "3. STENCIL 0.12 mm laser cut, trapezoidal walls. U1/U2 land patterns are at 0.200 mm" (at 23 193.56) (layer "Cmts.User") (uuid "21f1bb35-fee3-5590-92f3-cb3de6c77b4a")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   and U10 at 0.150 mm; all three are legal here by written exception" (at 23 195.24) (layer "Cmts.User") (uuid "3ae1759b-b638-594a-9112-28e6833213ea")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   (mccan.kicad_dru), not by accident. Reduce paddle apertures to ~70% area." (at 23 196.92) (layer "Cmts.User") (uuid "b9afea37-600b-551f-8db9-59ea94a1aba1")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "4. ASK BEFORE FAB: the quoted hole-to-hole minimum is written against 'vias <= 0.45" (at 23 198.6) (layer "Cmts.User") (uuid "27b32057-e149-513d-b228-c86acef8cea3")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   mm'. Every via here is 0.5 / 0.55 / 0.6 / 0.8 mm, so it is not clear whether the" (at 23 200.28) (layer "Cmts.User") (uuid "fbbe7bc1-c024-52c4-a9e7-e677d95a6ee1")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "   0.3 mm rule this board is built to applies, or a wider one does." (at 23 201.96) (layer "Cmts.User") (uuid "637bd68c-1e6e-502a-af75-f0051d348c84")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "" (at 23 203.64) (layer "Cmts.User") (uuid "d775d440-c963-5227-8698-53cf419ecc3a")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
