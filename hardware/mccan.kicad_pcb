	(gr_text "LAYOUT CONSTRAINTS (spec 9.3, 9.4, 10 / plan Task 8)" (at 23 124) (layer "Cmts.User") (uuid "f3946ad9-acf3-59f3-99e4-437917e76ec9")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "4 layers: F.Cu signal, In1.Cu GND solid and unbroken, In2.Cu power, B.Cu signal." (at 23 126.1) (layer "Cmts.User") (uuid "0b6deb7b-5b06-5adc-81ba-22d9accdb64d")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "COPPER: 1 oz OUTER (35 um), 2 oz INNER (70 um). NOT the usual way round -- 1 oz" (at 23 128.2) (layer "Cmts.User") (uuid "ebead352-1490-5255-9211-d0afccb63745")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "outer is what holds U10's 0.15 mm land pattern; 2 oz inner carries the 7.0 A feed." (at 23 130.3) (layer "Cmts.User") (uuid "8390de89-429b-50a6-9766-0d13ce3e264d")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Assembly is SINGLE SIDED -- nothing on B.Cu." (at 23 132.4) (layer "Cmts.User") (uuid "402da31b-bd88-5bcb-ba1c-b5a11f1e8441")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "FEED path (7.0 A cont, 7.8 A transient): In2.Cu polygon >= 5.75 mm effective width" (at 23 134.5) (layer "Cmts.User") (uuid "be2a0d9b-9623-5f67-b6ae-37a662149a1d")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "(IPC-2221, 10 C rise, internal, 2 oz = spec 10 5-6 mm). On F.Cu the FEED class floor is" (at 23 136.6) (layer "Cmts.User") (uuid "1944b8a8-d571-5400-bdfa-05ec6f088d14")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "3.5 mm = a 20 C rise; POUR to >= 4.5 mm for 10 C on any real run. No TRACK carries it." (at 23 138.7) (layer "Cmts.User") (uuid "a0b62477-d0a0-5f3a-a148-391a76fa2760")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "HEAT LEAVES THROUGH THE BASE, NOT AN EDGE: the plate is the face UNDER the board and" (at 23 140.8) (layer "Cmts.User") (uuid "b30f8082-e586-5e25-90c0-5e58208aa056")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "couples through B.Cu. Thermal group L2 (0.78 W), U9 (0.35 W), L1 (0.28 W), U3, L3 --" (at 23 142.9) (layer "Cmts.User") (uuid "788310ee-4946-5085-a091-817cb5d77c57")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "~1.6 W of the 2.31 W night total. L2 has no paddle; its heat goes to board copper." (at 23 145) (layer "Cmts.User") (uuid "1d50037a-afa2-5c7a-8589-a70ef4ace621")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "There are NO external boost FETs and NO P-FET. Night governs, not daytime." (at 23 147.1) (layer "Cmts.User") (uuid "6ec9d2e1-b58e-5493-ab3e-6e2c209d8123")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "eFuse island near J1, and NOT via-coupled to the plate: U10, Q10, Q11, R100, C65." (at 23 149.2) (layer "Cmts.User") (uuid "df81f70a-ee7b-5250-afc2-fb560ad48139")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "R100 needs its own copper and a Kelvin tap. C65 must sit AT U10 pin 5." (at 23 151.3) (layer "Cmts.User") (uuid "73d34c43-0c5d-51b3-8b24-ea04e0fe421e")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Antenna edge is RIGHT: no copper, plating or parts on ANY layer in the U5 keep-out." (at 23 153.4) (layer "Cmts.User") (uuid "719ade1f-4cc7-5292-9c41-cba9d3c46a1a")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Wire-exit field is BOTTOM: J1 power at the far left, J2 CAN at the far right." (at 23 155.5) (layer "Cmts.User") (uuid "943cda08-c784-516f-99ea-f6b952b2d398")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "Boost switch-node loop area minimised; gate loops short and tight." (at 23 157.6) (layer "Cmts.User") (uuid "3d9c24bc-de22-56af-9d21-3bede4fff7ad")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "GND_IN and GND are SEPARATE and meet at TWO places only: L2 winding B, and R3." (at 23 159.7) (layer "Cmts.User") (uuid "44f25b37-68ee-51a6-8ee0-8592c1f7f353")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "The plane must not bridge them anywhere else -- see scripts/check_grounds.py." (at 23 161.8) (layer "Cmts.User") (uuid "f20d7dc1-3083-564d-aeb0-97314305ef25")
		(effects (font (size 1.5 1.5) (thickness 0.225)) (justify left))
	)
	(gr_text "THERMAL / FAB" (at 102 124) (layer "Cmts.User") (uuid "061a2300-ac41-521f-b3d7-07e19935f713")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "VIA IN PAD: U1.9, U2.9, U3.17, U9.15 and D4.3 are filled with 0.5 / 0.25 mm vias." (at 102 125.68) (layer "Cmts.User") (uuid "139db962-c946-5e53-a7b9-4000d8171da9")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "These MUST be plugged and capped (IPC-4761 type IV or VI) -- unplugged vias in a" (at 102 127.36) (layer "Cmts.User") (uuid "d84f65e3-ff4e-5c35-9b43-d5e707e98ba2")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "solderable paddle wick paste out of the joint and void the thermal path they exist for." (at 102 129.04) (layer "Cmts.User") (uuid "f7669b44-92ad-507a-9b95-0f96365f0905")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "Heat leaves through B.Cu: assembly is single sided and the bottom is bare on purpose." (at 102 130.72) (layer "Cmts.User") (uuid "acc36c22-ed13-5708-8c44-c848630fa9a0")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "Gap pad contacts the two dashed Cmts.User patches, ~1360 mm2 total. Do not tent the" (at 102 132.4) (layer "Cmts.User") (uuid "1dce682b-5193-5491-87f0-e5939f441ebb")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "stitching vias inside them on B.Cu any more than the rest of the bottom side." (at 102 134.08) (layer "Cmts.User") (uuid "22569645-e679-5dcf-ad73-e97186bd714e")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
	(gr_text "U10 is MSOP-10 with NO exposed pad; its dissipation leaves through the lead frame." (at 102 135.76) (layer "Cmts.User") (uuid "5ec80eac-4852-56b1-8884-a377df2dcee7")
		(effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
	)
